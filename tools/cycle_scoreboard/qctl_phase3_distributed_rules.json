      "event_types": ["SIGNAL_SAMPLE"],
      "mapping_statuses": ["DIRECT"],
      "source_views": {
        "CMODEL": {"phase": "PRE_POSEDGE", "sample_point": "PRE_POSEDGE"},
        "RTL": {"phase": "PRE_POSEDGE", "sample_point": "PRE_POSEDGE"}
