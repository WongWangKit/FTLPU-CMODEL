        "qctl_load_manager.partition_base",
        "qctl_load_manager.partition_count",
        "qctl_load_manager.partition_generation",
        "qctl_load_manager.load_valid",
        "qctl_load_manager.load_ready",
        "qctl_load_manager.load_fire",
        "qctl_load_manager.load_address",
        "qctl_load_manager.load_data",
        "qctl_relay_chain.relay_packet_valid",
        "qctl_relay_chain.relay_packet_ready",
        "qctl_relay_chain.relay_packet_kind",
        "qctl_relay_chain.relay_packet_queue",
        "qctl_relay_chain.relay_packet_offset",
        "qctl_relay_chain.east_r0_input_fire",
        "qctl_relay_chain.east_r0_local_fire",
        "qctl_relay_chain.east_r0_output_valid",
        "qctl_relay_chain.east_r0_output_ready",
        "qctl_relay_chain.east_r0_fifo_level",
