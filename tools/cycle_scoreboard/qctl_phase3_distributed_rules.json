{
  "schema": "ftlpu.qctl.phase3.distributed.normalized.v1",
  "test_name": "qctl_phase3_distributed_joint_cycle_scoreboard",
  "title": "QCTL Phase 3 Distributed Load Joint Cycle Scoreboard",
  "required_fields": [
    "schema", "run_id", "case_id", "source", "global_cycle",
    "logical_cycle", "transport_tick", "phase", "sample_point",
    "event_sequence", "module", "instance", "signal", "width",
    "value", "event_type", "mapping_status", "source_ref"
  ],
  "allowed_event_types": ["SIGNAL_SAMPLE"],
  "allowed_mapping_statuses": ["DIRECT"],
  "comparable_mapping_statuses": ["DIRECT"],
  "excluded_mapping_statuses": [],
